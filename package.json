{
	"name": "@axc/condition",
	"version": "0.2.0",
	"type": "module",
	"description": "A lightweight, UI-adaptable React condition builder with AI-assisted rule generation and configurable precondition–AI decision–postcondition workflows.",
	"license": "MIT",
	"files": [
		"dist",
		"docs/*.md",
		"docs/*.tsx",
		"README.md",
		"README.zh-CN.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/types/core/index.d.ts",
			"import": "./dist/core.js"
		},
		"./styles.css": "./dist/styles.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
		"check": "tsc --noEmit && node scripts/check-boundaries.mjs && eslint . --max-warnings 0 && knip",
		"test": "npm run test:react19 && npm run test:react18",
		"test:react19": "node --import tsx --import ./tests/setup/dom.ts --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=98 --test-coverage-branches=95 --test-coverage-functions=93 'tests/**/*.test.ts' 'tests/**/*.test.tsx'",
		"pretest:react18": "npm --prefix tests/react18 install --no-audit --no-fund --silent",
		"test:react18": "node --import ./tests/setup/react18.mjs --import tsx --import ./tests/setup/dom.ts --test 'tests/**/*.test.ts' 'tests/**/*.test.tsx'",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"dev": "node scripts/dev.mjs",
		"prepare": "npm run build",
		"api": "api-extractor run --local && api-extractor run --local -c api-extractor.core.json",
		"api:check": "api-extractor run && api-extractor run -c api-extractor.core.json",
		"size": "node scripts/check-size.mjs",
		"verify": "npm run format:check && npm run check && npm test && npm run build && npm run api:check && npm run size",
		"demo:build": "node scripts/dev.mjs --build"
	},
	"engines": {
		"node": ">=22.18"
	},
	"peerDependencies": {
		"react": "^18.3.0 || ^19.0.0"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "21.0.4",
		"@microsoft/api-extractor": "7.60.1",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@types/node": "26.1.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"ajv": "8.20.0",
		"esbuild": "0.28.2",
		"eslint": "10.15.0",
		"eslint-plugin-react-hooks": "7.1.1",
		"knip": "6.45.1",
		"prettier": "3.10.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tsx": "4.22.4",
		"typescript": "6.0.3",
		"typescript-eslint": "8.73.0"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/axclogo/AxcCondition.git"
	},
	"homepage": "https://github.com/axclogo/AxcCondition",
	"bugs": {
		"url": "https://github.com/axclogo/AxcCondition/issues"
	}
}
